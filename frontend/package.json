{
  "name": "dsolar-erp-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "ng serve --host localhost",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "format": "prettier --write src angular.json tsconfig*.json package.json proxy.conf.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check src angular.json tsconfig*.json package.json proxy.conf.json eslint.config.mjs .prettierrc.json",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.6.2"
}
