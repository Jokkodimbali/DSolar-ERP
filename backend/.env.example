DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
JWT_ACCESS_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_DE_PLUS_DE_32_CARACTERES
JWT_REFRESH_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE_DE_PLUS_DE_32_CARACTERES

# Set only to the verified number of trusted reverse proxies; never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
LEDGER_AUTOMATION_WORKER=false

# Enable after provisioning and testing a dedicated non-owner runtime login.
DB_REQUIRE_RESTRICTED_ROLE=false
